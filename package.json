{
  "name": "dimicall-electron",
  "private": true,
  "version": "1.0.3",
  "description": "Application de gestion de contacts DimiCall",
  "author": "Dimultra",
  "main": "./dist/main/main.js",
  "homepage": "./",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "electron-vite build",
    "build": "electron-vite build",
    "build:debug": "cross-env ENABLE_SOURCEMAP=true ENABLE_OBFUSCATION=false electron-vite build",
    "build:obfuscate": "cross-env ENABLE_OBFUSCATION=true electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",

    "test:sim": "node scripts/test-sim-selection.js",
    "test:update": "node scripts/test-update.cjs",
    "analyze:xml": "node scripts/test-xml-analysis.cjs",
    "test:adb-permissions": "node scripts/test-adb-permissions.cjs",
    "validate:adb-solution": "node scripts/validate-adb-solution.cjs",
    "generate-icons": "node scripts/generate-icons-robust.cjs",
    "generate-icons-alt": "electron-icon-maker --input=DDD.png --output=build",
    "generate-icons-old": "electron-icon-builder --input=DDD.png --output=build --flatten",
    "publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/uuid": "^11.0.0",
    "@yume-chan/adb": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.1.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "jotai": "^2.19.1",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-aria-components": "^1.17.0",
    "react-day-picker": "^9.14.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "web-vitals": "^5.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^24.10.9",
    "@types/papaparse": "^5.5.2",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "41.2.1",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "electron-icon-maker": "^0.0.5",
    "electron-vite": "6.0.0-beta.1",

    "typescript": "~6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-javascript-obfuscator": "^3.1.0"
  },
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.1.8",
    "@radix-ui/react-focus-scope": "1.1.2",
    "@radix-ui/react-portal": "1.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doctorbankai/Dimi_Call.git"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "doctorbankai",
      "repo": "Dimi_Call"
    },
    "appId": "com.dimultra.dimicall",
    "productName": "DimiCall",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "build/**/*"
    ],
    "asarUnpack": [
      "dist/renderer/**/*"
    ],
    "afterPack": "scripts/fix-macos-permissions.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "platform-tools-latest-darwin (2)/platform-tools",
          "to": "platform-tools",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win32-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "platform-tools-latest-windows (4)/platform-tools",
          "to": "platform-tools",
          "filter": [
            "**/*"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "node_modules/electron/dist/icudtl.dat",
          "to": "icudtl.dat"
        },
        {
          "from": "node_modules/electron/dist/*.pak",
          "to": "./"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}",
      "unpackDirName": "DimiCall"
    }
  }
}